# CloudWatch dimensions for the two load balancers and target groups.
locals {
  public_alb_dimension = split(
    "loadbalancer/",
    module.alb_public.alb_arn
  )[1]

  public_target_group_dimension = split(
    "targetgroup/",
    module.alb_public.target_group_arn
  )[1]

  internal_alb_dimension = split(
    "loadbalancer/",
    module.alb_internal.alb_arn
  )[1]

  internal_target_group_dimension = split(
    "targetgroup/",
    module.alb_internal.target_group_arn
  )[1]
}

# 1. Detect unhealthy frontend targets.
resource "aws_cloudwatch_metric_alarm" "public_alb_unhealthy_targets" {
  alarm_name        = "securevault-public-alb-unhealthy-targets"
  alarm_description = "Detects unhealthy frontend targets."

  namespace   = "AWS/ApplicationELB"
  metric_name = "UnHealthyHostCount"
  statistic   = "Maximum"
  period      = 300

  evaluation_periods  = 2
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"

  dimensions = {
    LoadBalancer = local.public_alb_dimension
    TargetGroup  = local.public_target_group_dimension
  }

  treat_missing_data = "notBreaching"
}

# 2. Detect unhealthy backend targets.
resource "aws_cloudwatch_metric_alarm" "internal_alb_unhealthy_targets" {
  alarm_name        = "securevault-internal-alb-unhealthy-targets"
  alarm_description = "Detects unhealthy backend targets."

  namespace   = "AWS/ApplicationELB"
  metric_name = "UnHealthyHostCount"
  statistic   = "Maximum"
  period      = 300

  evaluation_periods  = 2
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"

  dimensions = {
    LoadBalancer = local.internal_alb_dimension
    TargetGroup  = local.internal_target_group_dimension
  }

  treat_missing_data = "notBreaching"
}

# 3. Detect HTTP 5xx errors generated by the public ALB.
resource "aws_cloudwatch_metric_alarm" "public_alb_5xx_errors" {
  alarm_name        = "securevault-public-alb-5xx-errors"
  alarm_description = "Detects HTTP 5xx errors generated by the public ALB."

  namespace   = "AWS/ApplicationELB"
  metric_name = "HTTPCode_ELB_5XX_Count"
  statistic   = "Sum"
  period      = 300

  evaluation_periods  = 1
  threshold           = 5
  comparison_operator = "GreaterThanOrEqualToThreshold"

  dimensions = {
    LoadBalancer = local.public_alb_dimension
  }

  treat_missing_data = "notBreaching"
}

# 4. Detect high RDS CPU utilization.
resource "aws_cloudwatch_metric_alarm" "rds_cpu" {
  alarm_name        = "securevault-rds-high-cpu"
  alarm_description = "Detects high database CPU utilization."

  namespace   = "AWS/RDS"
  metric_name = "CPUUtilization"
  statistic   = "Average"
  period      = 300

  evaluation_periods  = 2
  threshold           = 80
  comparison_operator = "GreaterThanOrEqualToThreshold"

  dimensions = {
    DBInstanceIdentifier = "${local.config.project}-db"
  }

  treat_missing_data = "notBreaching"
}

# 5. Detect low available RDS storage.
resource "aws_cloudwatch_metric_alarm" "rds_free_storage" {
  alarm_name        = "securevault-rds-low-free-storage"
  alarm_description = "Detects when available database storage falls below 2 GB."

  namespace   = "AWS/RDS"
  metric_name = "FreeStorageSpace"
  statistic   = "Minimum"
  period      = 300

  evaluation_periods  = 2
  threshold           = 2147483648
  comparison_operator = "LessThanOrEqualToThreshold"

  dimensions = {
    DBInstanceIdentifier = "${local.config.project}-db"
  }

  treat_missing_data = "notBreaching"
}
